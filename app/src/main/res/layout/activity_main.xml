<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="8dp"
    tools:context=".MainActivity">

    <!-- Левая колонка: пункты анкеты -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="@string/last_name"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="@string/first_name"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="@string/middle_name"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="@string/birth_year"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="@string/school"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="@string/city"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="@string/programming_experience"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="@string/programming_languages"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Центральная колонка: виджеты для ввода данных -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/editLastName"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:inputType="textPersonName"
            android:textSize="14sp"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/editFirstName"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:inputType="textPersonName"
            android:textSize="14sp"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/editMiddleName"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:inputType="textPersonName"
            android:textSize="14sp"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/editBirthYear"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:inputType="number"
            android:textSize="14sp"
            tools:ignore="Autofill,LabelFor" />

        <EditText
            android:id="@+id/editSchool"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:inputType="text"
            android:textSize="14sp"
            tools:ignore="Autofill,LabelFor" />

        <RadioButton
            android:id="@+id/radioCity"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <RadioButton
            android:id="@+id/radioExperience"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/checkLanguages"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Правая колонка: календарь -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
    </LinearLayout>

</LinearLayout>
